FROM nginx:1.27-alpine

LABEL org.opencontainers.image.title="ArenaPass Frontend" \
      org.opencontainers.image.version="1.6.2" \
      org.opencontainers.image.description="Static responsive frontend and reverse proxy for ArenaPass"

      COPY nginx.conf /etc/nginx/conf.d/default.conf
      COPY frontend/index.html frontend/styles.css frontend/app.js frontend/i18n.js frontend/Tanha-FD.woff2 /usr/share/nginx/html/
      COPY frontend/iran_counties.json /usr/share/nginx/html/

EXPOSE 80
